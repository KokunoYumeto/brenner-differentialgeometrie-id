{"batchcomplete":true,"query":{"pages":[{"pageid":22191870,"ns":6,"title":"File:Euler spiral.svg","contentmodel":"wikitext","pagelanguage":"en","pagelanguagehtmlcode":"en","pagelanguagedir":"ltr","touched":"2026-07-18T00:54:14Z","lastrevid":1179090202,"length":1488,"imagerepository":"local","imageinfo":[{"timestamp":"2025-12-04T03:42:16Z","user":"Mikhail Ryazanov","size":31848,"width":800,"height":800,"url":"https://upload.wikimedia.org/wikipedia/commons/9/91/Euler_spiral.svg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Euler_spiral.svg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=22191870","sha1":"df9e31d9c0a85a3801468b040b7f063e5cbc2498","extmetadata":{"DateTime":{"value":"2025-12-04 03:42:16","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Euler spiral","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Euler spirals|Self-published work|Valid SVG created with Other tools:Trigonometry","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"The Euler spiral as precise Bézier arcs. The spiral was calculated by numerically solving the differential equation that defines the Euler spiral, to an error less than 1e-6, at points were the curve direction makes equal angular steps, of 0.001°. The spiral was then divided in segments, to each of which a cubic Bézier arc was fitted so that in no point the fitting error was larger than 1e-6. For this, the spiral was cut in the places where it makes the following angles: 0°, 1°, 5°, 15° and then every 15° up to 10*360°. The SVG file preserves the 1e-6 accuracy level.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2012-10-19","source":"commons-desc-page"},"Credit":{"value":"<span class=\"int-own-work\" lang=\"en\">Own work<