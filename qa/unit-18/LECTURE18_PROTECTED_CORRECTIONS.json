    {
      "correction_id": "O011-CORR-0210",
      "anchor": "Transformation formula for a pulled-back positive volume form",
      "change": "Equip L with the pullback orientation and use positively oriented charts; without an orientation condition the source's signless integral identity fails for an orientation-reversing diffeomorphism."
    },
    {
      "correction_id": "O011-TRANS-0211",
      "anchor": "Independent Unit 18 lecture reader-language review",
      "change": "Repair respectively-chart, induced-isometry, and partial-derivative phrasing, and restore two accidental diagram-spacing commands, without changing mathematical content."
    },
    {
      "correction_id": "O011-CORR-0212",
      "anchor": "Ambient linear isometry example",
      "change": "Clarify that the otherwise undefined symbol in phi(M) denotes the ambient linear isometry under discussion."
    },
    {
      "correction_id": "O011-CORR-0213",
      "anchor": "Pullback of the canonical volume form under an isometry",
      "change": "Insert the omitted differential-map symbol in both occurrences of T_P phi(u_i); the frozen source writes the undefined T_P(u_i)."
    },
    {
      "correction_id": "O011-CORR-0214",
      "anchor": "Poincare upper-half-plane model",
      "change": "Define H to equal the displayed upper half-plane because the immediately following isometry uses H as domain while the frozen source defines only mathbb H."
    },
    {
      "correction_id": "O011-CORR-0215",
      "anchor": "Two-sheeted-hyperboloid figure caption",
      "change": "Normalize the frozen source typo Minkowsi-Form to bentuk Minkowski in the Indonesian caption."
    },
    {
      "correction_id": "O011-CORR-0216",
      "anchor": "Two-sheeted hyperboloid tangent-space basis and positivity computation",
      "change": "Replace the source's non-tangent first vector and inconsistent expansion by the valid basis (z,0,x),(0,z,y) and its exact Minkowski-norm identity a^2+b^2+(ay-bx)^2."
    },
    {
      "correction_id": "O011-CORR-0217",
      "anchor": "Disk-to-hyperboloid isometry, three Minkowski inner products",
      "change": "Remove the impossible point subscript (a,b) from the Y metric; (a,b) lies in the disk, not on Y, and the induced Minkowski form is point-independent."
    },
    {
      "correction_id": "O011-ACC-0226",
      "anchor": "Poincarehalfplaneconform.gif reader caption",
      "change": "Add a faithful Indonesian description of the conformal half-plane-to-disk animation and disclose the static PDF first frame plus preserved HTML/download animation; the frozen source caption is empty."
    },
    {
      "correction_id": "O011-ACC-0229",
      "anchor": "Hyperboloid2.png caption print reflow",
